{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.json", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/booking", "dest": "/booking.html" },
    { "src": "/booking.html", "dest": "/booking.html" },
    { "src": "/survey", "dest": "/survey.html" },
    { "src": "/survey.html", "dest": "/survey.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/shop", "dest": "/shop.html" },
    { "src": "/shop.html", "dest": "/shop.html" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/apple-touch-icon.png", "dest": "/apple-touch-icon.png" },
    { "src": "/favicon-32x32.png", "dest": "/favicon-32x32.png" },
    { "src": "/icon-192.png", "dest": "/icon-192.png" },
    { "src": "/icon-512.png", "dest": "/icon-512.png" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "."
}
