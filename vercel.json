{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/booking", "dest": "/booking.html" },
    { "src": "/booking.html", "dest": "/booking.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "."
}
